{
  "name": "thronectl",
  "version": "0.3.0",
  "description": "Host daemon and CLI for the thronectl Cardputer ADV firmware",
  "type": "module",
  "license": "MIT",
  "bin": {
    "thronectl": "dist/cli.js",
    "throne": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/test/*.test.js\"",
    "start": "node dist/cli.js daemon"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
